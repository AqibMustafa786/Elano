rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Super Admin has every permission; staff only those listed in their claim.
    function can(permission) {
      return isAdmin()
        || (signedIn()
          && request.auth.token.get("staff", false) == true
          && request.auth.token.get("perms", []).hasAny([permission]));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if can("catalog") || resource.data.status == "published";
      allow write: if can("catalog");
    }

    match /categories/{categoryId} {
      allow read: if can("catalog") || resource.data.status == "published";
      allow write: if can("catalog");
    }

    match /collections/{collectionId} {
      allow read: if can("catalog") || resource.data.status == "published";
      allow write: if can("catalog");
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || can("customers");
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "email",
          "photoURL",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "photoURL",
          "phone",
          "updatedAt"
        ])
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read: if isOwner(userId) || can("customers");
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "fullName",
            "phone",
            "addressLine1",
            "addressLine2",
            "city",
            "state",
            "postalCode",
            "countryCode",
            "updatedAt"
          ]);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /carts/{userId} {
      allow read: if isOwner(userId) || can("customers");
      allow write: if can("customers");
    }

    match /wishlists/{userId} {
      allow read: if isOwner(userId) || can("customers");
      allow write: if can("customers");
    }

    match /orders/{orderId} {
      allow read: if can("orders")
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if can("orders");
    }

    match /coupons/{couponId} {
      allow read, write: if can("coupons");
    }

    match /reviews/{reviewId} {
      allow read: if can("reviews") || resource.data.status == "approved";
      allow write: if can("reviews");
    }

    match /banners/{bannerId} {
      allow read: if can("cms") || resource.data.isPublished == true;
      allow write: if can("cms");
    }

    match /testimonials/{testimonialId} {
      allow read: if can("cms") || resource.data.isPublished == true;
      allow write: if can("cms");
    }

    match /newsletterSubscribers/{subscriberId} {
      allow read, write: if can("newsletter");
    }

    match /settings/{settingId} {
      allow read: if can("settings") || settingId == "public";
      allow write: if can("settings");
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
